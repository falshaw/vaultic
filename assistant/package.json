{
  "name": "vaultic-assistant",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Nick Falshaw",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3029",
    "build": "next build",
    "start": "next start -p 3029",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file sbom.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "lucide-react": "^0.474.0",
    "next": "^16.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "unpdf": "^1.6.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^16.4.7",
    "prisma": "^7.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "@hono/node-server": ">=1.19.13",
    "esbuild": ">=0.28.1"
  }
}
