# Copy to .env and replace every "replace-with" value before `docker compose up`.

# PostgreSQL (audit log, users, document metadata)
POSTGRES_USER=vaultic
# letters and digits only (it is embedded in a database URL)
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=vaultic

# Session signing key: at least 32 random characters. Generate with one of:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_SECRET=

# First admin account, created on the first login when the user table is empty
VAULTIC_ADMIN_EMAIL=admin@example.com
VAULTIC_ADMIN_PASSWORD=replace-with-a-strong-password

# Host port for the web UI (bound to 127.0.0.1)
VAULTIC_PORT=3029

# --- Models ---------------------------------------------------------------
# Bundled Ollama container (CPU by default, GPU via docker-compose.gpu.yml).
# The vaultic-models service pulls GEN_MODEL and EMBED_MODEL on first start.
COMPOSE_PROFILES=ollama
GEN_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
# EMBED_DIM must match EMBED_MODEL (nomic-embed-text = 768)
EMBED_DIM=768

# Use an existing Ollama instead of the bundled one: delete the COMPOSE_PROFILES
# line above and point OLLAMA_URL at it. Both GEN_MODEL and EMBED_MODEL must be
# pulled there. host.docker.internal reaches Ollama on the Docker host.
# OLLAMA_URL=http://host.docker.internal:11434

# CPU cores for the bundled Ollama (container limit AND the thread count sent with
# each request; they must match or inference crawls). Set 0 for an external Ollama.
# OLLAMA_CPUS=6

# Optional: set to true only when the app sits behind a trusted reverse proxy
# (client IP is then read from X-Forwarded-For for rate limiting / audit)
# TRUST_PROXY=false
