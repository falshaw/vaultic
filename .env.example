# Copy to .env and replace every value before `docker compose up`.

# PostgreSQL (audit log, users, document metadata)
POSTGRES_USER=vaultic
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=vaultic

# Session signing key: at least 32 characters, random.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# First admin account, created on first login attempt when the user table is empty
VAULTIC_ADMIN_EMAIL=admin@example.com
VAULTIC_ADMIN_PASSWORD=replace-with-a-strong-password

# Local models served by the bundled Ollama container
GEN_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# Optional: set to true only when the app sits behind a trusted reverse proxy
# (client IP is then read from X-Forwarded-For for rate limiting / audit)
# TRUST_PROXY=false
